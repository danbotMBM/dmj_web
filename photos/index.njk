---
title: photos · danbot lab
description: "A simple gallery of travel and amateur photography from around the world, taken by Daniel Mark Jones."
extraCss:
  - /photos/photosStyle.css
---
{% extends "layouts/base.njk" %}

{% block content %}
<main class="gallery-page">
    <h2 id="title">Photos</h2>
    <div id="jumbodiv"></div>
    <footer class="gallery-footer">
        <a id="admin-link" href="/photos/admin/" hidden>admin</a>
    </footer>
</main>
<div id="image-viewer">
    <span id="close-btn">&times;</span>
    <img id="full-image" src="" alt="Full View" />
    <h3 id="full-image-caption"></h3>
</div>
{% endblock %}

{% block scripts %}
{% raw %}
<script type="module">
    import { get_photos, get_title, focal_position } from "/photos.js";
    const grid = document.getElementById("jumbodiv");
    get_photos().then(photos => {
        photos.forEach(element => {
            const cell = document.createElement("div");
            cell.className = "pic-row";
            const img = document.createElement("img");
            img.src = "pics/low/" + element.filename;
            img.title = get_title(element);
            img.className = "lazyload";
            img.alt = element.description || element.location || "";
            img.style.objectPosition = focal_position(element);
            cell.appendChild(img);
            if (element.location) {
                const overlay = document.createElement("div");
                overlay.className = "pic-overlay";
                cell.appendChild(overlay);
                const caption = document.createElement("figcaption");
                caption.className = "pic-caption";
                caption.textContent = element.location;
                cell.appendChild(caption);
            }
            grid.appendChild(cell);
        });
        // Re-scan for lazyload now that images exist.
        if (typeof observe_lazy_images === "function") observe_lazy_images();
    });
    // Reveal the admin link only when a login token is present in the browser.
    if (localStorage.getItem('dmj-auth-token')) {
        document.getElementById('admin-link').hidden = false;
    }
</script>
{% endraw %}
<script src="/lazyload.js"></script>
{% endblock %}
