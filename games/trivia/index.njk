---
title: The Daily Board · danbot lab
description: "Play a free daily trivia game. Jeopardy-style questions across history, pop culture, sports, geography and more — a new board every day. Maximize your score before three wrong answers."
extraCss:
  - /games/trivia/trivia.css
---
{% extends "layouts/base.njk" %}

{% block content %}
<article class="markdown-body" style="position:relative;">
    <button id="settings-btn" class="settings-gear-btn" title="Settings" aria-label="Settings">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
        </svg>
    </button>
    <h1>The Daily Board</h1>
    <p id="date-display" style="text-align:center; color:var(--fgColor-muted); margin-bottom:4px;"></p>

    <div id="status-bar">
        <span id="score-display">Score: 0</span>
        <span id="strikes-display"></span>
    </div>

    <div id="grid-container"></div>
    <div id="reset-container" class="hidden" style="text-align:center; margin-top:16px;">
        <button id="reset-btn">Play Again</button>
    </div>
    <p style="text-align:center; margin-top:16px;"><a href="/games/trivia/past/">Past boards</a></p>
    <p id="stats-link" style="text-align:center; display:none;"><a href="/games/trivia/stats/">Stats</a></p>

    <div id="question-overlay" class="overlay hidden">
        <div class="overlay-card">
            <div id="question-category" class="question-meta"></div>
            <div id="question-points" class="question-meta"></div>
            <p id="question-text"></p>
            <div id="answer-section">
                <input type="text" id="answer-input" placeholder="Your answer..." autocomplete="off">
                <button id="submit-btn">Submit</button>
            </div>
            <div id="result-section" class="hidden">
                <p id="result-text"></p>
                <p id="result-answer"></p>
                <button id="continue-btn">Continue</button>
            </div>
        </div>
    </div>

    <div id="settings-overlay" class="overlay hidden">
        <div class="overlay-card">
            <h2>Settings</h2>
            <div class="settings-section">
                <p class="settings-label">Display name</p>
                <p class="settings-desc">Shown on the daily leaderboard.</p>
                <div class="settings-sync-row">
                    <input type="text" id="settings-name-input" placeholder="Enter a name…" maxlength="20" autocomplete="off" spellcheck="false">
                    <button id="settings-name-btn">Save</button>
                </div>
                <p id="settings-name-status" class="hidden settings-status-text"></p>
            </div>
            <hr class="settings-divider">
            <div class="settings-section">
                <p class="settings-label">Your Player ID</p>
                <p class="settings-desc">Copy this ID to sync your stats to another browser.</p>
                <div class="settings-id-row">
                    <code id="settings-player-id"></code>
                    <button id="settings-copy-id-btn">Copy</button>
                </div>
                <p id="settings-copy-confirm" class="hidden settings-success">Copied!</p>
            </div>
            <hr class="settings-divider">
            <div class="settings-section">
                <p class="settings-label">Sync from another browser</p>
                <p class="settings-desc">Paste a Player ID from another browser to import its stats.</p>
                <div class="settings-sync-row">
                    <input type="text" id="settings-id-input" placeholder="Paste 16-character ID…" maxlength="16" autocomplete="off" spellcheck="false">
                    <button id="settings-sync-btn">Sync</button>
                </div>
                <p id="settings-status" class="hidden settings-status-text"></p>
            </div>
            <button id="settings-close-btn">Close</button>
        </div>
    </div>

    <div id="gameover-overlay" class="overlay hidden">
        <div class="overlay-card">
            <h2 id="gameover-title"></h2>
            <p id="gameover-score"></p>
            <pre id="gameover-grid"></pre>
            <div id="gameover-stats">
                <div class="stat-row">
                    <span class="stat-label">Average</span>
                    <span id="stat-average" class="stat-value">-</span>
                </div>

            </div>
            <div id="gameover-chart-wrap">
                <div class="chart-title">Last 7 days</div>
                <div id="gameover-chart"></div>
            </div>
            <div id="leaderboard-wrap" class="hidden">
                <div class="chart-title">Today's Top 3</div>
                <ol id="gameover-leaderboard" class="leaderboard"></ol>
                <p id="gameover-rank" class="leaderboard-rank"></p>
                <div id="gameover-name-entry" class="name-entry hidden">
                    <p class="settings-label">Your name</p>
                    <div class="settings-sync-row">
                        <input type="text" id="gameover-name-input" placeholder="Enter a name…" maxlength="20" autocomplete="off" spellcheck="false">
                        <button id="gameover-name-btn">Save</button>
                    </div>
                    <p id="gameover-name-status" class="hidden settings-status-text"></p>
                </div>
            </div>
            <button id="copy-btn">Copy Results</button>
            <p id="copy-confirm" class="hidden">Copied!</p>
            <button id="close-gameover-btn">Close</button>
        </div>
    </div>
</article>
{% endblock %}

{% block scripts %}
{% raw %}
<script type="module">
    if (localStorage.getItem("dmj-auth-token")) {
        document.getElementById("stats-link").style.display = "";
    }
</script>
{% endraw %}
<script type="module" src="/games/trivia/trivia.js"></script>
{% endblock %}
