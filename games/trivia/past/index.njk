---
title: Past Daily Trivia Boards · danbot lab
description: "Browse and replay past daily trivia boards — catch up on previous days' Jeopardy-style questions across history, pop culture, sports and more."
---
{% extends "layouts/base.njk" %}

{% block head %}
{% raw %}
<style>
    .past-list {
        max-width: 500px;
        margin: 0 auto;
        list-style: none;
        padding: 0;
    }
    .past-list li {
        margin-bottom: 8px;
    }
    .past-list a {
        display: block;
        padding: 14px 20px;
        background: #3b82f6;
        color: #fff;
        border-radius: 8px;
        text-decoration: none;
        font-size: 1.1rem;
        font-weight: 600;
        transition: background 0.15s, transform 0.1s;
    }
    .past-list a:hover {
        background: #2563eb;
        transform: scale(1.02);
        color: #fff;
        text-decoration: none;
    }
    .past-list a:active {
        transform: scale(0.98);
    }
    #loading {
        text-align: center;
        color: var(--fgColor-muted);
        padding: 32px 0;
    }
</style>
{% endraw %}
{% endblock %}

{% block content %}
<article class="markdown-body">
    <h1>Past Boards</h1>
    <p><a href="/games/trivia/">&larr; Back to today's board</a></p>
    <div id="loading">Loading...</div>
    <ul id="past-list" class="past-list"></ul>
</article>
{% endblock %}

{% block scripts %}
{% raw %}
<script type="module">
    import { API_BASE } from "/utils.js";

    async function loadDays() {
        const loading = document.getElementById("loading");
        const list = document.getElementById("past-list");

        try {
            const resp = await fetch(API_BASE + "/trivia/days");
            if (!resp.ok) {
                loading.textContent = "No past boards available.";
                return;
            }
            const data = await resp.json();
            const dates = data.dates || [];

            if (dates.length === 0) {
                loading.textContent = "No past boards available.";
                return;
            }

            loading.style.display = "none";

            // Show most recent first
            const sorted = [...dates].sort().reverse();
            for (const date of sorted) {
                const li = document.createElement("li");
                const a = document.createElement("a");
                a.href = "/games/trivia/?date=" + encodeURIComponent(date);
                a.textContent = date;
                li.appendChild(a);
                list.appendChild(li);
            }
        } catch (e) {
            console.error("Failed to load past trivia days:", e);
            loading.textContent = "Failed to load past boards.";
        }
    }

    loadDays();
</script>
{% endraw %}
{% endblock %}
